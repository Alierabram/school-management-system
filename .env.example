# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bugemadesk?retryWrites=true&w=majority

# JWT Secret - generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Server port (Render sets this automatically)
PORT=3000

# Node environment
NODE_ENV=production

# REQUIRED in production: initial registrar account (used only on first boot when no users exist)
INITIAL_ADMIN_EMAIL=registrar@bugemauniv.ac.ug
INITIAL_ADMIN_PASSWORD=change-this-to-a-strong-password
