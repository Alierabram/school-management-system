# Copy this file to .env and replace the example secrets before use.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/test
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=ChangeMe-Admin-Password-2026
ADMIN_NAME=School Administrator

# Optional demo student login. Leave STUDENT_EMAIL blank to skip seeding a student account.
# STUDENT_ADMISSION_NO must match an existing student record (created in the Students module first).
STUDENT_EMAIL=
STUDENT_PASSWORD=
STUDENT_ADMISSION_NO=
